# Copy this file to ".env" and fill it in. ".env" is ignored by git.
# Leave everything empty for development: the game then uses Google's test ads.
#
# All values come from https://admob.google.com  (Apps -> your app -> App settings / Ad units).

# --- AdMob APP IDs (contain "~"). Read at build time by app.config.js and written
# --- into AndroidManifest.xml / Info.plist. Rebuild the app after changing them.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# --- Ad UNIT IDs (contain "/"). Read by src/ads/AdConfig.ts.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=

# --- Switches
# 0 builds the game with no ads at all.
EXPO_PUBLIC_ADMOB_ENABLED=1
# 1 forces Google's test ads even in a release build (use it for internal test builds).
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=0
# 1 if the store listing targets children: ads are requested as child-directed, rated G.
EXPO_PUBLIC_ADMOB_CHILD_DIRECTED=0
# Your own phones, comma separated, so they always get test ads (the ID is printed in the device log).
EXPO_PUBLIC_ADMOB_TEST_DEVICES=

# --- Interstitial frequency
# Offer an interstitial after this many completed levels.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_EVERY_LEVELS=3
# Minimum seconds between two full-screen ads.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_MIN_INTERVAL_SEC=120

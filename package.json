{
  "name": "trail-torque",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Trail Torque - 3D off-road driving simulator (Three.js) + classic 2D hill-climb (Phaser 3), packaged with Capacitor",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "bot": "node scripts/bot.mjs",
    "physcheck": "node scripts/physcheck.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/screen-orientation": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "phaser": "^3.90.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.3.0"
  }
}

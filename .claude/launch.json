    {
      "name": "mobile3d-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile3d",
        "run",
        "web",
        "--",
        "--port",
        "8091",
        "--max-workers",
        "1"
      ],
      "port": 8091
    }
  ]
}
